# Ora 5G — modelo minimo da plataforma (desenvolvimento/apresentacao).
# Execute os comandos a partir da raiz do monorepo.
# Copie este modelo para apps/plataforma/.env.local; nunca versione o arquivo preenchido.
# O catalogo de variaveis futuras fica no .env.example da raiz.
# Guia por fase: docs/alinhamento/CONFIGURACAO_E_TRANSICAO_DO_MOCKUP.md

# Demonstracao com dados ficticios. Em producao, use APP_ENV=producao:
# /demo retorna 404 nesse modo e nao deve ser usado como sistema real.
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100

# Padroes da aplicacao; as regras atuais trabalham com BRL e America/Sao_Paulo.
APP_TIMEZONE=America/Sao_Paulo
APP_DEFAULT_CURRENCY=BRL

# OPCIONAL: a loja online (/loja) mostra os produtos desta organizacao (o id, uuid).
# Vazio = loja online desligada.
LOJA_ONLINE_ORGANIZACAO=

# OPCIONAL para a apresentacao. Preencha o par apenas para testar o login real,
# usando o projeto de desenvolvimento e SOMENTE a chave publica publishable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nao colocar aqui credenciais administrativas apenas para habilitar o login.
# Banco SQL, worker e provedores externos recebem configuracao na fase propria.
# No terminal do processo Node, usar NODE_OPTIONS=--dns-result-order=ipv4first.
