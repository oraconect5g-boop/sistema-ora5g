# =============================================================================
# Ora 5G Platform — variáveis de ambiente (MODELO)
# -----------------------------------------------------------------------------
# - Este arquivo NÃO contém valores reais. Copie para `.env.local` (dev) e
#   preencha. Em homologação/produção, cadastre no gerenciador de segredos do
#   servidor (VPS) — nunca no Git, no chat ou em print de tela.
# - Explicação de cada chave, onde obter e status: docs/integracoes/VARIAVEIS_DE_AMBIENTE.md
# - Variáveis com prefixo NEXT_PUBLIC_ vão para o navegador: NUNCA coloque
#   segredo nelas.
# - Tokens por loja/conta (Mercado Livre, Shopee, TikTok Shop, PagBank Connect)
#   NÃO ficam aqui: ficam no banco, criptografados, pois vencem e são renovados.
# - Legenda: [OBRIGATÓRIA] núcleo · [INTEGRAÇÃO] só quando o módulo for ligado
#   · [BLOQUEADA] depende de decisão/contrato ainda não confirmado
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Aplicação [OBRIGATÓRIA]
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | homologacao | producao
ORA_DEMO_DESLIGADA=                 # "1" tira a demonstração (/demo) do ar; vazio = no ar, isolada (DEMO-a, ADR-022)
# Endereço público: https://ora5g.com.br (a loja online fica em /loja, no mesmo domínio; ADR-009 e ENTREGAS-a).
# NEXT_PUBLIC_LOJA_URL é histórica: nenhum código a lê hoje (conferido em 18/11, auditoria do Codex de 17/11).
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_LOJA_URL=http://127.0.0.1:3001
# Loja online (ONLINE-a, ADR-009): o id da organização que a vitrine pública (/loja) mostra.
# Vazio = loja online desligada. Não é segredo, mas fica só no servidor (o web lê em tempo de execução).
LOJA_ONLINE_ORGANIZACAO=
# Log de tempos (VEL-a, ADR-010): com "1", o servidor escreve na saída uma linha por ida ao banco (só o caminho
# e o tempo; nunca filtro, corpo, chave ou token). Vazio = desligado, que é o normal. Serve para medir e desligar.
ORA_MEDIR_TEMPOS=
# Servidor só IPv4 (ver docs/adr/ADR-001): usar 127.0.0.1, nunca "localhost".
# Portas internas: 30xx produção, 31xx homologação.
PORT_PLATAFORMA=3000
PORT_LOJA=3001
PORT_WORKER_SAUDE=3010
NODE_OPTIONS=--dns-result-order=ipv4first
APP_TIMEZONE=America/Sao_Paulo
APP_DEFAULT_CURRENCY=BRL
# Chave mestra para criptografar tokens de integração guardados no banco
# (32 bytes em base64; gerar com: openssl rand -base64 32). Uma por ambiente.
APP_ENCRYPTION_KEY=
# Segredo que protege as rotinas automáticas (worker/agendador) chamadas por URL
CRON_SECRET=

# ---------------------------------------------------------------------------
# 2. Banco de dados e login — Supabase [OBRIGATÓRIA]
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # chave pública (respeita RLS)
SUPABASE_SECRET_KEY=                    # SÓ no servidor; ignora RLS — uso restrito
# Servidor só IPv4: usar a string do POOLER COMPARTILHADO em MODO SESSÃO
# (painel Supabase → Connect → Session pooler), formato:
# postgresql://postgres.<projeto>:<senha>@aws-<n>-<regiao>.pooler.supabase.com:5432/postgres
# NÃO usar a conexão direta db.<projeto>.supabase.co (é só IPv6).
DATABASE_URL=
# Histórica: nenhum código lê este nome hoje; cada área usa o seu bucket privado, criado pela migration (anexos, contas,
# notas, os e produtos). Conferido em 18/11 (auditoria do Codex de 17/11).
SUPABASE_STORAGE_BUCKET_DOCUMENTOS=documentos-privados

# ---------------------------------------------------------------------------
# 3. E-mail transacional (nota, OS, recuperação de senha) [OBRIGATÓRIA]
# ---------------------------------------------------------------------------
EMAIL_FROM="Ora 5G <nao-responda@ora5g.com.br>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# 4. Avisos no celular (desconto, nota e saída de caixa a aprovar; lote PWA-b, ADR-014)
# ---------------------------------------------------------------------------
# Gerados NO SERVIDOR pelo Claude Code, com a autorização do proprietário (17/11/2026); nunca passam pelo chat.
# A pública (base64url do ponto P-256 não comprimido) vai ao navegador; a privada e o segredo da fila ficam só com o
# worker dos avisos (deploy/homologacao/worker-avisos.sh). O banco guarda só a impressão digital SHA-256 do segredo.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://ora5g.com.br
WEB_PUSH_SEGREDO_DA_FILA=

# ---------------------------------------------------------------------------
# 5. Nogle — Ora Connect [INTEGRAÇÃO] (API oficial da Nogle)
#    Fonte: https://docs.nogle.tech/ (POST /auth/token). O endereço abaixo é o que a documentação oficial indica.
# ---------------------------------------------------------------------------
NOGLE_API_BASE_URL=https://api.conteltelecom.com.br
NOGLE_AUTH_KEY_TYPE=                # franquia | marca | pdv; a da Ora é marca (o login de verdade com a chave sozinha, 24/11/2026)
NOGLE_ACCESS_KEY=                   # chave de acesso da Ora (secreta)
NOGLE_SECONDARY_KEY=                # chave_acesso_franquia (franquia) ou chave_acesso_pdv (PDV); vazia para marca/MVNO (secreta)
#    Controles do worker da Ora Connect (ADR-005; não são segredo). Só no ambiente do worker.
NOGLE_OPERACOES_HABILITADAS=        # ex.: ativacao,recarga,portabilidade — só as homologadas com a Nogle
NOGLE_GET_COM_CORPO=                # "documentado": a Nogle confirmou o GET com corpo em 10/11/2026
NOGLE_CONSULTA_PAGAMENTO=           # "habilitada": confirma ativação/recarga pelo uuid (GET /consultaPagamento), depois de a Nogle liberar a rota e de ver o uuid numa resposta real
NOGLE_TRANSFERENCIAS=               # "habilitada": o worker envia os pedidos de transferência de chips do dono (CONNECT-e, 25/11/2026)
NOGLE_ACOES=                        # "habilitada": o worker envia as ações na Nogle pedidas pelo dono e pelos gerentes (CONNECT-j, 25/11/2026)
ORA_ORGANIZACAO_ID=                 # id da organização dona das credenciais da Nogle (uuid do banco)
CONNECT_UFS=                        # UFs das cidades da ativação, ex.: RS,SC

# ---------------------------------------------------------------------------
# 6. Emissão fiscal por API [BLOQUEADA — provedor e contador não definidos]
#    O certificado A1 fica no provedor fiscal ou no cofre de segredos,
#    NUNCA em arquivo dentro do projeto.
# ---------------------------------------------------------------------------
FISCAL_PROVIDER=                    # nome do provedor escolhido
FISCAL_API_BASE_URL=
FISCAL_API_TOKEN=
FISCAL_ENVIRONMENT=homologacao      # homologacao | producao

# ---------------------------------------------------------------------------
# 7. Link de pagamento online [INTEGRAÇÃO]
# ---------------------------------------------------------------------------
# PicPay — Link de Pagamento (OAuth2 client_credentials)
PICPAY_CLIENT_ID=
PICPAY_CLIENT_SECRET=
PICPAY_WEBHOOK_SECRET=              # validação dos avisos de pagamento (a confirmar formato)
# PagBank (PagSeguro) — token de integração da conta
PAGBANK_ENVIRONMENT=sandbox         # sandbox | producao
PAGBANK_API_TOKEN=
# Maquininhas físicas (PicPay POS e PagSeguro): sem API nesta fase;
# conciliação por comprovante/extrato.
# Asaas — o pagamento pelo site com Pix (lote PAY-014a, ADR-025; a escolha do proprietário em 24/11). Só no ambiente do
# worker dos pagamentos (deploy/homologacao/worker-pagamentos.sh): o site não recebe a chave. O token do aviso (webhook) é
# gerado pelo worker ao registrar o aviso na Asaas; não há variável para ele (o banco guarda só a impressão digital).
ASAAS_AMBIENTE=                     # sandbox | producao (a chave de teste começa com $aact_hmlg_; a de produção, com $aact_prod_)
ASAAS_API_KEY=                      # a chave da API da conta Asaas da Ora (secreta)
ASAAS_EMAIL_DOS_AVISOS=             # o e-mail que a Asaas avisa se a fila de avisos parar

# ---------------------------------------------------------------------------
# 8. WhatsApp Business Platform — API oficial (Cloud API) [INTEGRAÇÃO]
# ---------------------------------------------------------------------------
WHATSAPP_GRAPH_API_VERSION=         # versão da Graph API em uso (fixar ao integrar)
WHATSAPP_BUSINESS_ACCOUNT_ID=       # WABA ID
WHATSAPP_PHONE_NUMBER_ID=           # ID do número que envia as mensagens
WHATSAPP_ACCESS_TOKEN=              # token permanente de Usuário do Sistema
WHATSAPP_APP_SECRET=                # valida a assinatura X-Hub-Signature-256
WHATSAPP_WEBHOOK_VERIFY_TOKEN=      # texto aleatório criado por nós

# ---------------------------------------------------------------------------
# 9. Meta Ads — dados de campanha (Marketing API) [INTEGRAÇÃO]
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=             # token de Usuário do Sistema com leitura de anúncios
META_AD_ACCOUNT_IDS=                # lista separada por vírgula: act_123,act_456
META_PIXEL_ID=                      # se a loja virtual enviar eventos de conversão

# ---------------------------------------------------------------------------
# 10. Mercado Livre [INTEGRAÇÃO]
#     Tokens do vendedor (6 h) e refresh token ficam no BANCO, criptografados.
# ---------------------------------------------------------------------------
MERCADOLIVRE_APP_ID=                # client_id
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=          # deve ser idêntica à cadastrada no app
MERCADOLIVRE_WEBHOOK_PATH=/api/webhooks/mercadolivre

# ---------------------------------------------------------------------------
# 11. Shopee Open Platform v2 [INTEGRAÇÃO]
#     shop_id, access_token e refresh_token de cada loja ficam no BANCO.
# ---------------------------------------------------------------------------
SHOPEE_ENVIRONMENT=sandbox          # sandbox | producao
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# 12. TikTok Shop (Partner Center) [INTEGRAÇÃO]
#     access_token, refresh_token e shop_cipher de cada loja ficam no BANCO.
# ---------------------------------------------------------------------------
TIKTOKSHOP_APP_KEY=
TIKTOKSHOP_APP_SECRET=
TIKTOKSHOP_SERVICE_ID=              # usado no link de autorização (a confirmar)
TIKTOKSHOP_REDIRECT_URI=

# ---------------------------------------------------------------------------
# 13. Monitoramento de erros [OPCIONAL]
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Sem variáveis por decisão do projeto:
# - Rein: somente importação por arquivo CSV (sem API).
# - PayJoy e Aiva (Flexphone): lançamento manual da venda financiada nesta fase.
# ---------------------------------------------------------------------------
